{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,

    "skipLibCheck": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@parnaibadigital/design-system": ["./packages/design-system/src/index.css"],
      "@parnaibadigital/design-system/*": ["./packages/design-system/src/*"],
      "@parnaibadigital/ui": ["./packages/ui/src/index.ts"],
      "@parnaibadigital/ui/*": ["./packages/ui/src/*"],
      "@parnaibadigital/types": ["./packages/types/src/index.ts"],
      "@parnaibadigital/types/*": ["./packages/types/src/*"],
      "@parnaibadigital/api-client": ["./packages/api-client/src/index.ts"],
      "@parnaibadigital/api-client/*": ["./packages/api-client/src/*"],
      "@parnaibadigital/validation": ["./packages/validation/src/index.ts"],
      "@parnaibadigital/validation/*": ["./packages/validation/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".astro", "backend"]
}
