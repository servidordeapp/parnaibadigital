{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-declaration-strict-value"],
  "ignoreFiles": [
    "packages/design-system/vendor/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/.astro/**",
    "backend/**"
  ],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "color",
        "fill",
        "stroke",
        "/^margin/",
        "/^padding/",
        "gap",
        "row-gap",
        "column-gap",
        "/^border-radius/",
        "box-shadow",
        "font-family",
        "font-size",
        "font-weight",
        "line-height",
        "letter-spacing",
        "/^transition-duration/",
        "animation-duration"
      ],
      {
        "ignoreValues": [
          "currentColor",
          "inherit",
          "initial",
          "unset",
          "transparent",
          "none",
          "auto",
          "0",
          "revert",
          "currentcolor",
          "1ms",
          "0ms"
        ],
        "ignoreFunctions": false,
        "disableFix": true,
        "message": "Princípio VI / FR-004: use um token do Design System (var(--…)), nunca um valor literal."
      }
    ],
    "custom-property-pattern": null,
    "selector-class-pattern": null,
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "apply",
          "utility",
          "variant",
          "source",
          "plugin",
          "custom-variant"
        ]
      }
    ],
    "import-notation": null,
    "value-keyword-case": null
  }
}
