{
  "name": "@parnaibadigital/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tipos de domínio gerados do contrato OpenAPI 3.1 — o contrato é a fonte de verdade (D-10).",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/api-v1.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../specs/001-fundacao-prototipo-monorepo/contracts/openapi-v1.yaml --output ./src/generated/api-v1.ts --root-types",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1"
  }
}
