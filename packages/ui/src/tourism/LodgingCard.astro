---
import type { Lodging } from "./types";

import Icon from "../core/Icon.astro";
import PhotoFrame from "../core/PhotoFrame.astro";

/**
 * Card de hospedagem do guia de turismo.
 *
 * A nota aparece como texto ("4,8 de 5"), não como fileira de estrelas: o vocabulário de
 * ícones do DS não publica `star`, e o próprio `readme.md` proíbe desenhar SVG à mão ou usar
 * caractere unicode no lugar de ícone. O número também é o que a tecnologia assistiva
 * consegue anunciar sem depender de `aria-label` reconstruindo a informação.
 */
interface Props {
  lodging: Lodging;
  level?: "h2" | "h3" | undefined;
  class?: string | undefined;
}

const { lodging, level = "h3", class: className } = Astro.props;
const Heading = level;

const ratingLabel = new Intl.NumberFormat("pt-BR", { minimumFractionDigits: 1 }).format(
  lodging.rating,
);
---

<article class:list={["pd-lodging", className]}>
  <a class="pd-lodging__link" href={lodging.href}>
    <PhotoFrame ratio="4/3" radius="sm" class="pd-lodging__photo" />

    <div class="pd-lodging__body">
      <span class="pd-lodging__kind">{lodging.kind}</span>
      <Heading class="pd-lodging__name">{lodging.name}</Heading>

      <span class="pd-lodging__place">
        <Icon name="map-pin" size="xs" />
        {lodging.place}
      </span>

      <span class="pd-lodging__rating">
        {ratingLabel} de 5 · {lodging.reviewCount} avaliações
      </span>

      <span class="pd-lodging__price">{lodging.priceLabel}</span>
    </div>
  </a>
</article>

<style>
  .pd-lodging {
    border: var(--border-hair) solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    box-shadow: var(--shadow-1);
    transition: var(--transition-interactive);
  }

  .pd-lodging:hover {
    background: var(--surface-card-hover);
    box-shadow: var(--shadow-2);
    transform: translateY(-1px);
  }

  .pd-lodging__link {
    display: block;
    padding: var(--space-4);
    color: inherit;
    text-decoration: none;
  }

  .pd-lodging__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .pd-lodging__kind {
    font: var(--type-kicker);
    color: var(--text-hot);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  .pd-lodging__name {
    margin: 0;
    font: var(--type-headline-sm);
    color: var(--text-strong);
  }

  .pd-lodging__place,
  .pd-lodging__rating {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    font: var(--type-meta);
    color: var(--text-muted);
  }

  .pd-lodging__price {
    font: var(--type-data);
    color: var(--text-brand);
  }

  .pd-lodging__link:focus-visible {
    outline: var(--border-thick) solid var(--pd-blue-600);
    outline-offset: var(--space-1);
  }
</style>
