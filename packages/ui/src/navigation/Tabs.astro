---
/**
 * T040 — abas, com a aparência que o DS declara (altura de toque, sublinhado interno de
 * 3px, azul 700 no ativo, contagem opcional em `--type-kicker`).
 *
 * Divergência deliberada de semântica em relação ao DS: lá a aba é `<button role="tab">`
 * com `onChange`. Aqui cada aba é um `<a href>` dentro de um `<nav>`, e a ativa recebe
 * `aria-current="page"`.
 *
 * Duas razões, nesta ordem. (1) Princípio XI: as abas de utilidade pública (T072) e as do
 * painel são endereços reais — sem JavaScript, `role="tab"` com manipulador de clique não
 * troca nada, e o rastreador não enxerga os quatro grupos. (2) `role="tab"` promete a
 * quem usa leitor de tela um painel que troca no mesmo documento, com setas do teclado
 * navegando entre abas; prometer isso e então recarregar a página é pior que não prometer.
 * Aba que navega é navegação, e navegação é `<nav>` com `<a>`.
 */
import type { TabItem } from "./types";

interface Props {
  tabs: TabItem[];
  /** `href` da aba corrente. A comparação é por string, não por índice. */
  active: string;
  /** O que este conjunto de abas escolhe, para o `<nav>` ter nome próprio. */
  label: string;
  class?: string | undefined;
}

const { tabs, active, label, class: className } = Astro.props;
---

<nav class:list={["pd-tabs", className]} aria-label={label}>
  {
    tabs.map((tab) => {
      const isActive = tab.href === active;
      return (
        <a
          class:list={["pd-tabs__tab", isActive && "pd-tabs__tab--active"]}
          href={tab.href}
          aria-current={isActive ? "page" : undefined}
        >
          {tab.label}
          {tab.count !== undefined && <span class="pd-tabs__count">{tab.count}</span>}
        </a>
      );
    })
  }
</nav>

<style>
  .pd-tabs {
    display: flex;
    gap: var(--space-2);
    border-bottom: var(--border-hair) solid var(--border-default);
    /* Abaixo de 900px as abas rolam em vez de quebrar em duas linhas. */
    overflow-x: auto;
  }

  .pd-tabs__tab {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    height: var(--tap-min);
    padding: 0 var(--space-5);
    font: var(--type-ui);
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-interactive);
  }

  .pd-tabs__tab:hover {
    color: var(--text-strong);
    text-decoration: none;
  }

  /* Sublinhado por `inset box-shadow`, como no DS: não desloca a linha de base do rótulo
     nem come o hairline do contêiner, que um `border-bottom` faria. */
  .pd-tabs__tab--active {
    color: var(--pd-blue-700);
    box-shadow: inset 0 calc(var(--border-accent) * -1) 0 var(--pd-blue-600);
  }

  .pd-tabs__count {
    font: var(--type-kicker);
    color: var(--text-faint);
  }

  .pd-tabs__tab--active .pd-tabs__count {
    /* Alias, não rampa: o protótipo não re-aponta `--pd-blue-600` no escuro, então a
       contagem rendia 2,95:1 lá. `--text-brand` (= `--pd-blue-700`) é re-apontado. */
    color: var(--text-brand);
  }
</style>
