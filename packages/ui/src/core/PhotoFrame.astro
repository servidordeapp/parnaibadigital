---
import type { MediaRef } from "@parnaibadigital/types";

import Icon from "./Icon.astro";

/**
 * O produto não tem banco de imagens (Assumption 9). `PhotoFrame` existe para que a
 * ausência de foto não quebre o layout: sem `media`, cai para o placeholder azul hachurado
 * do DS — mantendo a MESMA proporção que a foto ocuparia, e portanto sem layout shift
 * (edge case "ausência de foto", Princípio I).
 *
 * Quando há foto, `width`/`height` vêm do `MediaRef` e são escritos como atributo: é deles
 * que o navegador tira a caixa antes de a imagem chegar.
 */
interface Props {
  media?: MediaRef | undefined;
  ratio?: "16/9" | "4/3" | "1/1" | "3/2" | undefined;
  radius?: "sm" | "md" | "lg" | undefined;
  /** Legenda curta sobre a foto — usado no hero. */
  label?: string | undefined;
  /** LCP da página: só a imagem principal recebe prioridade alta. */
  priority?: boolean | undefined;
  /** Dica de largura para o navegador escolher o derivado certo. */
  sizes?: string | undefined;
  class?: string | undefined;
}

const {
  media,
  ratio = "16/9",
  radius = "md",
  label,
  priority = false,
  sizes = "(min-width: 900px) 680px, 100vw",
  class: className,
} = Astro.props;

/**
 * Deriva o endereço do formato moderno trocando a extensão.
 *
 * Deliberadamente ingênuo: nesta fase nenhum serviço serve derivados, e inventar aqui uma
 * URL de transformação acoplaria o Design System a um fornecedor de storage — exatamente o
 * que o `MediaRef` opaco do contrato existe para evitar (D-10). O `<picture>` degrada
 * sozinho: se o AVIF não existir, o navegador cai para o WebP e depois para o original.
 */
function withExtension(url: string, extension: string): string {
  return url.replace(/\.(jpe?g|png|webp|avif)(\?.*)?$/i, `.${extension}$2`);
}
---

<figure
  class:list={["pd-photo", `pd-photo--r-${radius}`, className]}
  style={`--pd-photo-ratio: ${ratio};`}
>
  {
    media === undefined ? (
      <div class="pd-photo__placeholder" role="img" aria-label={label ?? "Imagem não disponível"}>
        <Icon name="image" size="xl" />
      </div>
    ) : (
      <picture>
        {/* AVIF primeiro: o navegador escolhe o primeiro formato que aceita. */}
        <source srcset={withExtension(media.url, "avif")} type="image/avif" sizes={sizes} />
        <source srcset={withExtension(media.url, "webp")} type="image/webp" sizes={sizes} />
        <img
          class="pd-photo__img"
          src={media.url}
          alt={media.alt}
          width={media.width}
          height={media.height}
          loading={priority ? "eager" : "lazy"}
          decoding={priority ? "sync" : "async"}
          fetchpriority={priority ? "high" : "auto"}
        />
      </picture>
    )
  }
  {media?.credit !== undefined && <figcaption class="pd-photo__credit">{media.credit}</figcaption>}
</figure>

<style>
  .pd-photo {
    position: relative;
    overflow: hidden;
    margin: 0;
    /* A proporção é reservada antes de qualquer pixel chegar — é o que segura o CLS. */
    aspect-ratio: var(--pd-photo-ratio);
    background: var(--surface-photo-fallback);
  }

  .pd-photo--r-sm {
    border-radius: var(--radius-sm);
  }
  .pd-photo--r-md {
    border-radius: var(--radius-md);
  }
  .pd-photo--r-lg {
    border-radius: var(--radius-lg);
  }

  .pd-photo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pd-photo__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    /* Hachura de 45° — a única textura que a marca aceita, junto do mapa do bairro. */
    background-image: repeating-linear-gradient(
      45deg,
      transparent,
      transparent var(--space-3),
      var(--pd-blue-200) var(--space-3),
      var(--pd-blue-200) var(--border-thick)
    );
    color: var(--pd-blue-400);
  }

  .pd-photo__credit {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-xs);
    background: rgb(
      4 22 44 / 62%
    ); /* stylelint-disable-line scale-unlimited/declaration-strict-value -- scrim de crédito sobre foto; mesma tinta do --scrim-photo do DS, que não é utilizável como fundo sólido */
    color: var(--text-inverse);
    font: var(--type-meta);
  }
</style>
