---
/**
 * `<select>` nativo, deliberadamente. Um combobox construído à mão custaria JavaScript no
 * cliente, teclado reimplementado e um contrato ARIA inteiro — e perderia o seletor nativo
 * do celular, que é o dispositivo primário aqui. O DS não pede aparência customizada.
 *
 * Como é nativo, o filtro de editoria e a ordenação do painel funcionam sem JavaScript
 * dentro de um `<form method="get">` (Princípio XI).
 */
interface Option {
  value: string;
  label: string;
}

interface Props {
  label: string;
  id: string;
  name?: string | undefined;
  options: Option[];
  value?: string | undefined;
  hint?: string | undefined;
  class?: string | undefined;
}

const { label, id, name: fieldName, options, value, hint, class: className } = Astro.props;
const hintId = hint === undefined ? undefined : `${id}-hint`;
---

<div class:list={["pd-select", className]}>
  <label class="pd-select__label" for={id}>{label}</label>
  <select class="pd-select__control" id={id} name={fieldName ?? id} aria-describedby={hintId}>
    {
      options.map((option) => (
        <option value={option.value} selected={option.value === value}>
          {option.label}
        </option>
      ))
    }
  </select>
  {
    hint !== undefined && (
      <p class="pd-select__hint" id={hintId}>
        {hint}
      </p>
    )
  }
</div>

<style>
  .pd-select {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pd-select__label {
    color: var(--text-strong);
    font: var(--type-ui-sm);
  }

  .pd-select__control {
    min-height: var(--tap-min);
    padding: var(--space-3) var(--space-4);
    border: var(--border-hair) solid var(--border-default);
    border-radius: var(--radius-sm);
    background: var(--surface-card);
    color: var(--text-body);
    font: var(--type-body-sm);
    transition: var(--transition-interactive);
  }

  .pd-select__control:focus-visible {
    border-color: var(--border-brand);
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .pd-select__control:disabled {
    background: var(--pd-ink-100);
    color: var(--text-faint);
    cursor: not-allowed;
  }

  .pd-select__hint {
    margin: 0;
    color: var(--text-muted);
    font: var(--type-meta);
  }
</style>
